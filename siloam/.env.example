# EXAMPLE SETTINGS ONLY. This file is public and the app does not load it.
#
# Copy it to .env in this folder (git ignores .env), then edit the values:
#     cp .env.example .env
#
# For any deployment, replace every REPLACE_ME value with your own. Anyone who knows
# JWT_SECRET can forge login tokens, including admin ones. To generate a value:
#     openssl rand -base64 48

# Environment variables declared in .env are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Accounts
BCRYPT_SALT_ROUNDS=10
SALT_LENGTH=256
JWT_SECRET="REPLACE_ME_this_is_an_example_not_a_real_secret"
JWT_EXPIRES_IN_ACCESS="1h"
JWT_EXPIRES_IN_REFRESH="1d"
API_URL="http://localhost:3000" # This is the general API URL to refer to this project's api endpoints
DATABASE_URL="file:./prisma/dev.db"
#DATABASE_PROVIDER="sqlite" # NEED TO MODIFY schema.prisma directly!!

# Image and audio features
OPENAI_API_KEY="REPLACE_ME_with_your_OpenAI_API_key"
SERVER_URL="http://localhost:3000" # Use this for all calls to the server
# The website's JavaScript includes this key, so visitors can read it. Use a value unique to your deployment.
CUSTOM_FILE_API_KEY="REPLACE_ME_with_your_own_random_value"
CUSTOM_FILE_API_PATH="http://localhost:3000" # Specify the path to the custom file server
CUSTOM_FILE_OUTPUT_PATH="http://localhost:3000/public" # Specify the path to the public output folder
OPENWEATHER_API_KEY="REPLACE_ME_with_your_OpenWeather_API_key"
